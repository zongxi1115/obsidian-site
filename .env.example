# --- 内容来源（只有这一块是必填的）---
# 本地开发时直接读本机的笔记目录（复制成 .env.local 用）
VAULT_DIR=C:/Users/zx/Documents/计算机

# 不设 VAULT_DIR 时（比如 Vercel 上）会浅克隆这个仓库。
# 换成任何一个装着 markdown 的 GitHub 仓库都行，不必是 Obsidian 建的。
# 私有仓库写成 https://x-access-token:<token>@github.com/owner/repo
VAULT_REPO=https://github.com/zongxi1115/obsidian-computer
VAULT_BRANCH=main

# --- 站点信息（可选，不填就从上面的仓库地址推出来）---
# 不填时：站名 = 仓库名，作者 = 仓库 owner
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_AUTHOR=
NEXT_PUBLIC_SITE_AUTHOR_URL=
# 自定义域名，影响 canonical / sitemap / OG 图的绝对地址
NEXT_PUBLIC_SITE_URL=

# --- AI 问答（可选，不填就不显示「问问 AI」按钮）---
# 任何 OpenAI 兼容端点都行：OpenRouter / 官方 OpenAI / 中转站 / 自建
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# 必须是上面那个端点认识的模型 ID
AI_MODEL=anthropic/claude-haiku-4.5

# --- 评论区（可选，不填就不显示评论）---
# 去 https://giscus.app 填一下仓库，它会把这四个值算给你。
# 前提：仓库是公开的、开了 Discussions、装了 giscus app。
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
